{
  "name": "dynamic-chemicals",
  "version": "2.0.0",
  "private": true,
  "description": "Dynamic Chemicals product catalogue and order tracking platform",
  "scripts": {
    "dev": "concurrently -n web,api -c green,cyan \"next dev\" \"tsx watch server/index.ts\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "next build",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "concurrently -n web,api \"next start\" \"node dist-server/server/index.js\"",
    "start:web": "next start",
    "start:api": "node dist-server/server/index.js",
    "check": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit && npm test",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/src/lib/validation.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.0.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
